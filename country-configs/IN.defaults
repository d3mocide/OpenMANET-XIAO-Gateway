# CI-only sdkconfig override, layered on top of sdkconfig.defaults via
# `idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;country-configs/IN.defaults"`.
# Bakes a real regulatory domain into the web-flasher's IN build - see
# .github/workflows/build-firmware.yml and design/pi_side_reference.md.
CONFIG_HALOW_COUNTRY_CODE="IN"
